{
    "name": "@varlabs/ai.openai",
    "version": "0.3.0",
    "description": "OpenAI provider for the AI SDK",
    "author": "HamzaKV <hamzakv333@gmail.com>",
    "repository": "https://github.com/HamzaKV/ai-sdk.git",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./src/index.js",
        "./stream-events": "./src/stream-events.js",
        "./chat-messages": "./src/chat-messages.js"
    },
    "scripts": {
        "clean": "rimraf ./dist",
        "copy-files:root": "copyfiles -u 0 README.md package.json LICENSE ./dist",
        "build": "pnpm run clean && tsc && pnpm run copy-files:root",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --exclude \"**/*.contract.test.ts\"",
        "test:watch": "vitest",
        "test:contract": "vitest run src/index.contract.test.ts",
        "coverage": "vitest run --coverage"
    },
    "packageManager": "pnpm@10.6.2",
    "devDependencies": {
        "copyfiles": "^2.4.1",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3",
        "vitest": "^3.1.4",
        "@vitest/coverage-v8": "3.1.4"
    },
    "dependencies": {
        "@varlabs/ai": "workspace:*",
        "@varlabs/ai.utils": "workspace:*"
    },
    "keywords": [
        "ai",
        "sdk",
        "typescript",
        "openai",
        "provider",
        "llm",
        "chatgpt",
        "gpt",
        "openai-api",
        "openai-provider",
        "openai-sdk"
    ],
    "publishConfig": {
        "access": "public"
    }
}
