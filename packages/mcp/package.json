{
    "name": "@varlabs/ai.mcp",
    "version": "0.1.2",
    "description": "MCP client for the AI SDK: connects to remote MCP servers over streamable HTTP and converts their tools into SDK Tool definitions",
    "author": "HamzaKV <hamzakv333@gmail.com>",
    "repository": "https://github.com/HamzaKV/ai-sdk.git",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./src/index.js"
    },
    "scripts": {
        "clean": "rimraf ./dist",
        "copy-files:root": "copyfiles -u 0 README.md package.json LICENSE ./dist",
        "build": "pnpm run clean && tsc && pnpm run copy-files:root",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage"
    },
    "packageManager": "pnpm@10.6.2",
    "devDependencies": {
        "copyfiles": "^2.4.1",
        "rimraf": "^6.0.1",
        "typescript": "^5.8.3",
        "vitest": "^3.1.4",
        "@vitest/coverage-v8": "3.1.4"
    },
    "dependencies": {
        "@varlabs/ai": "workspace:*"
    },
    "keywords": [
        "ai",
        "sdk",
        "typescript",
        "mcp",
        "model-context-protocol"
    ],
    "publishConfig": {
        "access": "public"
    }
}
