{
    "compilerOptions": {
        "lib": ["ESNext", "DOM"],
        "module": "ESNext",
        "target": "ESNext",
        "moduleDetection": "force",
        "allowJs": true,
        "jsx": "react-jsx",

        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "outDir": "./dist",
        "rootDir": ".",
        "baseUrl": ".",
        "resolveJsonModule": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,

        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,

        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false
    },
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.spec.tsx",
        "**/*.test.tsx",
        "./dist/**/*"
    ]
}
