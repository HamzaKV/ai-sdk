{
  "name": "@varlabs/ai.utils",
  "version": "1.0.2",
  "description": "Timeout-aware fetch wrappers for server and client environments, used across the AI SDK's provider packages",
  "author": "HamzaKV <hamzakv333@gmail.com>",
  "repository": "https://github.com/HamzaKV/ai-sdk.git",
  "type": "module",
  "exports": {
    "./fetch.server": "./src/fetch.server.js",
    "./fetch.client": "./src/fetch.client.js"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "copy-files:root": "copyfiles -u 0 README.md package.json LICENSE ./dist",
    "build": "pnpm run clean && pnpm run copy-files:root && tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "sdk",
    "typescript",
    "fetch"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.6.2",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "@vitest/coverage-v8": "3.1.4"
  },
  "dependencies": {
    "undici": "^6.21.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
